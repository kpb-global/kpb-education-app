<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+ runtime permission for FCM notification display -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="KPB Education"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:fullBackupContent="false"><!-- Don't back up the Supabase session (refresh token lives in shared_prefs) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kpb" />
            </intent-filter>
            <!-- Supabase OAuth (Google) / magic-link redirect. Must match
                 AppConfig.supabaseOAuthRedirect (io.supabase.kpbeducation://login-callback/)
                 and the Redirect URLs allow-list in the Supabase dashboard. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.supabase.kpbeducation" android:host="login-callback" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility?hl=en and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!--
          Visibilité des paquets (Android 11+ / API 30).

          POURQUOI CE BLOC EXISTE. `targetSdkVersion` vaut 36 : à partir d'API 30,
          une app ne « voit » que les paquets qu'elle déclare, et
          `canLaunchUrl` — qui repose sur `PackageManager.resolveActivity` —
          renvoie FAUX pour tout ce qui n'est pas déclaré, même quand un
          navigateur est installé. Ni ce manifeste ni celui d'url_launcher_android
          (vérifié dans ~/.pub-cache : il n'a AUCUN bloc `<queries>`) ne
          déclaraient d'intention VIEW.

          Ce que cela mettait en jeu : le bouton « Formulaire officiel » de
          chaque bourse, les liens de source officielle — l'affordance anti-fraude
          du produit — et surtout le renvoi WhatsApp, c'est-à-dire l'UNIQUE
          chemin de monétisation de l'app, puisqu'il n'y a délibérément aucun
          paiement in-app.

          INTERDIT ICI : `QUERY_ALL_PACKAGES`. C'est un motif de refus de
          politique Play, et sur une app déjà publiée le refus porterait sur la
          mise à jour elle-même. Les déclarations ci-dessous sont étroites et
          suffisantes.

          Le code ne dépend plus de `canLaunchUrl` (voir
          lib/app/core/utils/external_link.dart) : ce bloc et ce changement se
          couvrent mutuellement, l'un rendant la résolution possible, l'autre
          rendant l'échec visible plutôt que muet.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!--
          Le renvoi conseiller passe par une URL https://wa.me/… : les intentions
          ci-dessus suffisent à la résoudre vers un navigateur. Ces deux paquets
          sont déclarés en plus pour que le lien s'ouvre DIRECTEMENT dans
          WhatsApp (et WhatsApp Business, très répandu chez les conseillers de
          la région) au lieu de faire un détour par le navigateur.
        -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
    </queries>
</manifest>
